# Personal Windows LAN deployment used by the Mac build handoff.
# Copy to .env.production.local; that local file remains gitignored.
EXPO_PUBLIC_API_URL=http://192.168.3.162:8080
EXPO_PUBLIC_WEB_URL=http://192.168.3.162:3000
EXPO_BUNDLE_IDENTIFIER_PROD=com.andytane.multica.personal

# Set this only when Xcode needs a particular Apple Developer team.
# EXPO_APPLE_TEAM_ID=ABCDE12345
