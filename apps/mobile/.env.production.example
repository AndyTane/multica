# Copy this file to .env.production.local and fill in the address of your own
# U Workers deployment before running a production-variant build. The .local
# file is gitignored. There is no built-in default: the build fails without
# EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_API_URL=https://api.example.com

# Optional. Enables "Copy link" / "Open on web" actions in issue / project /
# comment menus. Without it those menu items just don't appear.
EXPO_PUBLIC_WEB_URL=https://example.com

# Optional: use your own reverse-domain if your Apple ID cannot sign the
# default production bundle ID.
# EXPO_BUNDLE_IDENTIFIER_PROD=com.yourname.multica
