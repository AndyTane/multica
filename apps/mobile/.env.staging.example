# Copy this file to .env.staging.local and fill in the address of your own
# staging deployment. Used by `pnpm dev:mobile:staging` and the
# `ios:*:staging` scripts via dotenv-cli (see package.json). The build fails
# without EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_API_URL=https://api.staging.example.com

# Optional. Enables "Copy link" / "Open on web" actions in issue / project /
# comment menus. Without it those menu items just don't appear.
EXPO_PUBLIC_WEB_URL=https://staging.example.com
