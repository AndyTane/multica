# Copy this file to .env.staging.local and fill in the address of your own
# staging deployment. Used by `pnpm dev:desktop:staging`
# (`electron-vite dev --mode staging`); without it Desktop uses localhost.
VITE_API_URL=https://api.staging.example.com

# VITE_APP_URL is the web app origin used for copy-link/open-in-browser URLs.
# Do not point it at the API host; set it explicitly when the web origin is
# not the API host without its `api.` prefix.
VITE_APP_URL=https://staging.example.com
