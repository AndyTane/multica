/docs/
*.md

# Only the web workspace and patches referenced by the root manifest are
# used by Dockerfile.web. Keep other app source out of the build context.
/apps/*
!/apps/web/
!/apps/mobile/
/apps/mobile/*
!/apps/mobile/patches/

# Repository-only tooling
/.github/
/deploy/
/scripts/
